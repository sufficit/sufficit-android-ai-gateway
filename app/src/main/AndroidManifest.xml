<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Acende a tela via full-screen intent quando chamado pela palavra de ativacao. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Sufficit Transcription IPC contract v1 (aidl/com/sufficit/ipc/transcription/,
         docs/ipc-transcription-contract.md): binds to sufficit-mobile-ai-models's
         TranscriptionIpcService, if that app is installed, to run transcription through its
         on-device Whisper model. -->
    <uses-permission android:name="com.sufficit.ipc.transcription.permission.PROVIDE_TRANSCRIPTION" />

    <!-- Android 11+ package visibility: without this, PackageManager can't see
         com.sufficit.ai.mobiledevice is installed, and bindService's implicit-intent
         resolution silently finds nothing. -->
    <queries>
        <package android:name="com.sufficit.ai.mobiledevice" />
        <package android:name="br.com.sufficit.vpn" />
        <intent><action android:name="br.com.sufficit.vpn.BIND" /></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_brand"
        android:roundIcon="@mipmap/ic_launcher_brand_round"
        android:label="Sufficit AI Gateway"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SufficitOpenClawGateway">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".audio.RoomAudioForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
